msgstr ""

#: business/templates/business/documentation.html:121
#: business/templates/business/documentation.html:127
msgid "Everyone"
msgstr "الجميع"

#: business/templates/business/documentation.html:126
msgid ""
"Full marketplace catalog with filters for category, price range, condition, "
