msgid "Function & Description"
msgstr "Maelezo"

#: business/templates/business/documentation.html:113
msgid "Audience"
msgstr "Hadhira"

#: business/templates/business/documentation.html:120
msgid ""
"Marketplace homepage displaying featured, trending, and latest listings "
"across campuses."
msgstr ""

#: business/templates/business/documentation.html:121
#: business/templates/business/documentation.html:127
msgid "Everyone"
msgstr "Kila mtu"

#: business/templates/business/documentation.html:126
msgid ""
"Full marketplace catalog with filters for category, price range, condition, "
"and campus location."
msgstr ""

#: business/templates/business/documentation.html:130
msgid "Chat (Inbox)"
msgstr "Chat (Inbox)"

#: business/templates/business/documentation.html:132
msgid ""
"Private real-time encrypted messaging between buyers and sellers with image "
